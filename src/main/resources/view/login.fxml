<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane alignment="CENTER" styleClass="login-fondo" stylesheets="@../css/app.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="pe.edu.upeu.alquileres.controller.LoginController">

    <VBox alignment="CENTER_LEFT" maxWidth="380.0" spacing="14.0" styleClass="login-card">
        <padding>
            <Insets bottom="30.0" left="34.0" right="34.0" top="34.0" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="14.0">
            <ImageView fitHeight="48.0" fitWidth="48.0" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/app-icon.png" />
                </image>
            </ImageView>
            <VBox spacing="2.0">
                <Label styleClass="login-titulo" text="SysAlquileres" />
                <Label styleClass="login-subtitulo" text="Gestión de alquileres de departamentos" />
            </VBox>
        </HBox>

        <Region styleClass="separador-suave">
            <VBox.margin>
                <Insets bottom="4.0" top="4.0" />
            </VBox.margin>
        </Region>

        <Label styleClass="login-etiqueta" text="USUARIO" />
        <TextField fx:id="txtUsuario" maxWidth="Infinity" onAction="#onIngresar" promptText="Ingresa tu usuario" />

        <Label styleClass="login-etiqueta" text="CLAVE" />
        <PasswordField fx:id="txtClave" maxWidth="Infinity" onAction="#onIngresar" promptText="Ingresa tu clave" />

        <Label fx:id="lblError" wrapText="true" />

        <Button defaultButton="true" maxWidth="Infinity" onAction="#onIngresar" styleClass="boton-primario" text="Ingresar al sistema" HBox.hgrow="ALWAYS">
            <VBox.margin>
                <Insets top="6.0" />
            </VBox.margin>
        </Button>

        <Button maxWidth="Infinity" onAction="#onSalir" styleClass="boton-secundario" text="Cerrar" />
    </VBox>
</StackPane>
