<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="pe.edu.upeu.alquileres.controller.UsuarioController"
      styleClass="modulo" stylesheets="@../css/app.css" spacing="14.0">

    <padding>
        <Insets top="18.0" right="22.0" bottom="18.0" left="22.0"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="10.0">
        <VBox spacing="1.0">
            <Label text="Accesos de clientes" styleClass="page-titulo"/>
            <Label text="Consulta y recupera la clave de acceso de los inquilinos a la APK"
                   styleClass="page-sub"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Buscar" styleClass="campo-etiqueta"/>
        <TextField fx:id="txtBuscar" promptText="DNI o nombre" prefWidth="180.0"/>
        <Label fx:id="lblConteo" text="0 clientes" styleClass="texto-conteo"/>
    </HBox>

    <VBox styleClass="card" spacing="10.0" VBox.vgrow="ALWAYS">
        <TableView fx:id="tblUsuarios" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colUsuario" text="DNI / usuario" prefWidth="130.0"/>
                <TableColumn fx:id="colNombre" text="Inquilino" prefWidth="220.0"/>
                <TableColumn fx:id="colRol" text="Rol" prefWidth="90.0"/>
                <TableColumn fx:id="colEstado" text="Estado" prefWidth="90.0"/>
                <TableColumn fx:id="colClave" text="Clave" prefWidth="120.0"/>
            </columns>
        </TableView>
        <CheckBox fx:id="chkMostrar" text="Mostrar claves en la tabla"/>
    </VBox>

    <VBox styleClass="card" spacing="10.0">
        <Label text="Recuperación de clave" styleClass="card-titulo"/>

        <GridPane hgap="12.0" vgap="10.0">
            <columnConstraints>
                <ColumnConstraints minWidth="150.0" prefWidth="180.0"/>
                <ColumnConstraints hgrow="ALWAYS" minWidth="260.0"/>
            </columnConstraints>

            <Label text="DNI (8 dígitos)" styleClass="campo-etiqueta" GridPane.rowIndex="0"/>
            <TextField fx:id="txtDni" promptText="Ej. 12345678" maxWidth="Infinity"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Nombre del cliente" styleClass="campo-etiqueta" GridPane.rowIndex="1"/>
            <TextField fx:id="txtNombre" promptText="Ej. Ana Quispe" maxWidth="Infinity"
                       GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="Clave" styleClass="campo-etiqueta" GridPane.rowIndex="2"/>
            <TextField fx:id="txtClave" promptText="Clave del cliente" maxWidth="Infinity"
                       GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        </GridPane>

        <HBox spacing="10.0">
            <Button fx:id="btnNuevo" text="Nuevo cliente" onAction="#onNuevo" styleClass="boton-primario"/>
            <Button fx:id="btnGenerar" text="Generar clave" onAction="#onGenerar"
                    styleClass="boton-secundario"/>
            <Button fx:id="btnGuardar" text="Guardar clave" onAction="#onGuardar"
                    styleClass="boton-primario" disable="true"/>
            <Button fx:id="btnEliminar" text="Eliminar" onAction="#onEliminar"
                    styleClass="boton-peligro" disable="true"/>
            <Button fx:id="btnActivar" text="Activar acceso" onAction="#onActivar"
                    styleClass="boton-exito" disable="true"/>
            <Button fx:id="btnDesactivar" text="Desactivar" onAction="#onDesactivar"
                    styleClass="boton-peligro" disable="true"/>
            <Button text="Actualizar lista" onAction="#onActualizar" styleClass="boton-secundario"/>
        </HBox>

        <Label fx:id="lblMensaje" wrapText="true"/>
        <Label wrapText="true" styleClass="texto-ayuda"
               text="La clave se guarda en texto plano por ser un proyecto académico. Entrega la nueva clave al inquilino para que ingrese en la APK."/>
    </VBox>
</VBox>
