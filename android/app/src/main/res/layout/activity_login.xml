<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="22dp"
    android:background="@drawable/gradient_header">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:padding="24dp">

        <TextView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:text="SA"
            android:textColor="@color/blanco"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/bg_avatar" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="SysAlquileres"
            android:textColor="@color/texto"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Versión móvil · UPeU Juliaca"
            android:textColor="@color/suave"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="USUARIO"
            android:textColor="@color/texto"
            android:textStyle="bold"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="admin"
            android:inputType="text"
            android:singleLine="true"
            android:padding="10dp"
            android:background="@drawable/bg_campo" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="CLAVE"
            android:textColor="@color/texto"
            android:textStyle="bold"
            android:textSize="12sp" />

        <EditText
            android:id="@+id/txtClave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="admin123"
            android:inputType="textPassword"
            android:singleLine="true"
            android:padding="10dp"
            android:background="@drawable/bg_campo" />

        <Button
            android:id="@+id/btnIngresar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:textColor="@color/blanco"
            android:textStyle="bold"
            android:background="@drawable/bg_boton_primario"
            android:text="Ingresar" />

        <TextView
            android:id="@+id/mensaje"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:textColor="@color/suave"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="Prueba: admin / admin123"
            android:textColor="@color/suave"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
